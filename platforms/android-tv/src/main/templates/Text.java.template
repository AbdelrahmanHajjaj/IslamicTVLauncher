    String stationWhere(Radio.Station s) { return d(ar ? s.whereAr : s.whereEn); }
    /** A station in a list: its name and place, since several are called إذاعة القرآن الكريم. */
    String stationChoice(Radio.Station s) { return s.reciter ? station(s) : station(s) + sep() + stationWhere(s); }
    String stationRow() { {{STRINGS:stationRow}} }
    String[] stationGroups() { {{STRINGS:stationGroups}} }
    String radioStatus(int s) {
        switch (s) {
            case Radio.PLAYING: return ar ? {{TEXT:ar:radioOn}} : {{TEXT:en:radioOn}};
            case Radio.CONNECTING: return ar ? {{TEXT:ar:radioConnecting}} : {{TEXT:en:radioConnecting}};
            case Radio.RETRYING: return ar ? {{TEXT:ar:radioRetrying}} : {{TEXT:en:radioRetrying}};
            case Radio.PAUSED: return ar ? {{TEXT:ar:radioPaused}} : {{TEXT:en:radioPaused}};
            default: return ar ? {{TEXT:ar:radioOff}} : {{TEXT:en:radioOff}};
        }
    }
