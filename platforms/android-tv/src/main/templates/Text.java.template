    // Screensaver (design/Screensaver.dc.html)
    /**
     * "in 27 min". Arabic counts take their proper forms: دقيقة واحدة، دقيقتين، ٣–١٠ دقائق، ١١+ دقيقة. An hour
     * or more reads as h:mm, as on Prayer day.
     */
    String inMinutes(long minutes, String hoursAndMinutes) {
        if (minutes >= 60) return in(hoursAndMinutes);
        if (!ar) return d({{TEXT:en:relativePrefix}} + minutes + {{TEXT:en:minuteUnit}});
        if (minutes <= 1) return {{TEXT:ar:minutesOne}};
        if (minutes == 2) return {{TEXT:ar:minutesTwo}};
        return d({{TEXT:ar:relativePrefix}} + minutes + (minutes <= 10 ? {{TEXT:ar:minutesUnit}} : {{TEXT:ar:minuteUnit}}));
    }

    // Reminder and call to prayer (design/Home.dc.html approach/now, design/ApproachVideo.dc.html)
    String apLabel() { {{STRINGS:apLabel}} }
    /** "Asr in 13 minutes". */
    String apTitle(String prayer, long minutes, String hoursAndMinutes) {
        if (!ar && minutes < 60) return d(prayer + {{TEXT:en:prayerInSeparator}} + minutes + (minutes == 1 ? {{TEXT:en:minuteSingular}} : {{TEXT:en:minutesUnit}}));
        return prayer + " " + inMinutes(minutes, hoursAndMinutes);
    }
    String apSub(CharSequence time) { return d((ar ? {{TEXT:ar:callTimePrefix}} : {{TEXT:en:callTimePrefix}}) + time); }
