        String ns = lat >= 0 ? (ar ? {{TEXT:ar:latitudeNorth}} : {{TEXT:en:latitudeNorth}}) : (ar ? {{TEXT:ar:latitudeSouth}} : {{TEXT:en:latitudeSouth}});
        String ew = lng >= 0 ? (ar ? {{TEXT:ar:longitudeEast}} : {{TEXT:en:longitudeEast}}) : (ar ? {{TEXT:ar:longitudeWest}} : {{TEXT:en:longitudeWest}});
        return d(String.format(java.util.Locale.US, "%.2f° %s · %.2f° %s", Math.abs(lat), ns, Math.abs(lng), ew)
            + (ar ? {{TEXT:ar:locationSuffix}} : {{TEXT:en:locationSuffix}}));
    }
