    }

    String methodName(PrayerMethod m) { return ar ? m.ar : m.en; }

    /** "Fajr angle 19.5° · Isha 17.5°", or Isha as minutes after Maghrib where the method fixes it that way. */
    String methodAngles(PrayerMethod m) {
        CalculationParameters p = m.getParameters();
        String fajr = (ar ? {{TEXT:ar:fajrAnglePrefix}} : {{TEXT:en:fajrAnglePrefix}}) + trim(p.fajrAngle) + "°";
        String isha = p.ishaInterval > 0
            ? (ar ? {{TEXT:ar:ishaIntervalPrefix}} + p.ishaInterval + {{TEXT:ar:ishaIntervalSuffix}} : {{TEXT:en:ishaIntervalPrefix}} + p.ishaInterval + {{TEXT:en:ishaIntervalSuffix}})
            : (ar ? {{TEXT:ar:ishaAnglePrefix}} : {{TEXT:en:ishaAnglePrefix}}) + trim(p.ishaAngle) + "°";
        return d(fajr + " · " + isha);
    }

    private static String trim(double v) {
        return v == Math.rint(v) ? String.valueOf((int) v) : String.valueOf(v);
    }

